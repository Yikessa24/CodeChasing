{
  "name": "codechasing",
  "displayName": "CodeChasing",
  "description": "Evidence-grounded research paper and code understanding inside VS Code.",
  "version": "0.30.6",
  "publisher": "codechasing",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeChasing.importPaper",
        "title": "CodeChasing: 导入论文 PDF"
      },
      {
        "command": "codeChasing.openPaper",
        "title": "CodeChasing: 打开当前论文"
      },
      {
        "command": "codeChasing.askPaper",
        "title": "CodeChasing: 就论文与代码提问"
      },
      {
        "command": "codeChasing.analyzeSelection",
        "title": "CodeChasing: 对选中代码提问或追踪样例",
        "shortTitle": "提问选中代码",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codeChasing.indexWorkspace",
        "title": "CodeChasing: 扫描工作区代码符号"
      },
      {
        "command": "codeChasing.openCallGraph",
        "title": "CodeChasing: 打开项目调用图"
      },
      {
        "command": "codeChasing.manageMappings",
        "title": "CodeChasing: 查看与审核论文↔代码对应关系"
      },
      {
        "command": "codeChasing.showPersistentExample",
        "title": "CodeChasing: 查看贯穿样例与张量形状追踪"
      },
      {
        "command": "codeChasing.configureProvider",
        "title": "CodeChasing: 配置模型提供商"
      },
      {
        "command": "codeChasing.testProvider",
        "title": "CodeChasing: 测试模型连接"
      },
      {
        "command": "codeChasing.moveToRight",
        "title": "CodeChasing: 把助手移到右侧"
      },
      {
        "command": "codeChasing.startWalkthrough",
        "title": "CodeChasing: 从头到尾讲解论文与代码"
      },
      {
        "command": "codeChasing.manageIndexes",
        "title": "CodeChasing: 管理论文与代码索引"
      },
      {
        "command": "codeChasing.openConversationHistory",
        "title": "CodeChasing: 打开历史对话"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codeChasing.analyzeSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "codeChasing.analyzeSelection",
          "when": "editorHasSelection",
          "group": "navigation@50"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeChasing.analyzeSelection",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeChasing",
          "title": "CodeChasing",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeChasing": [
        {
          "type": "webview",
          "id": "codeChasing.assistant",
          "name": "研究助手"
        }
      ]
    },
    "configuration": {
      "title": "CodeChasing",
      "properties": {
        "codeChasing.provider": {
          "type": "string",
          "enum": [
            "openai-compatible",
            "anthropic",
            "gemini"
          ],
          "default": "openai-compatible",
          "description": "模型 API 协议。Ollama 与 LM Studio 选 openai-compatible。"
        },
        "codeChasing.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "所选模型提供商的 base URL。"
        },
        "codeChasing.model": {
          "type": "string",
          "default": "gpt-4.1-mini",
          "description": "发送给提供商的模型名。"
        },
        "codeChasing.modelChoices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "gemini-3-pro-preview",
            "gemini-2.5-pro",
            "gemini-2.5-flash",
            "gemini-2.5-flash-lite",
            "gemini-2.0-flash",
            "claude-opus-4-5",
            "claude-sonnet-4-5",
            "claude-haiku-4-5",
            "claude-opus-4-1",
            "claude-sonnet-4-0",
            "gpt-5.2",
            "gpt-5.1",
            "gpt-5",
            "gpt-5-mini",
            "gpt-4.1",
            "o3",
            "o4-mini",
            "deepseek-chat",
            "deepseek-reasoner",
            "qwen-max",
            "qwen-plus",
            "qwen3-coder-plus"
          ],
          "description": "模型选择器额外考虑的模型名（叠加在提供商模型列表与当前模型之上）。每个候选都会先用已配置的 API key 探测权限，只展示探测通过的模型。可按自己的网关修改。"
        },
        "codeChasing.reasoningEffort": {
          "type": "string",
          "enum": [
            "auto",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "由提供商或模型自选默认推理强度。",
            "使用支持的最小推理强度。",
            "优先更低延迟与成本。",
            "平衡推理深度、延迟与成本。",
            "优先更深入推理。",
            "模型支持时使用超高推理强度。"
          ],
          "default": "auto",
          "description": "发送给兼容模型的推理强度。不支持的显式取值可能被提供商拒绝。"
        },
        "codeChasing.maxRepositoryFiles": {
          "type": "number",
          "default": 5000,
          "minimum": 10,
          "maximum": 20000,
          "description": "初始符号扫描与精简目录纳入的最大源码文件数。模型自主文本检索仍可检查所有非依赖工作区文件。"
        },
        "codeChasing.maxEvidenceChunks": {
          "type": "number",
          "default": 6,
          "minimum": 2,
          "maximum": 12,
          "description": "每次提问随附的论文证据块上限。"
        },
        "codeChasing.rerankEvidence": {
          "type": "boolean",
          "default": true,
          "description": "回答前用已配置模型对检索到的论文证据重排序（listwise，不超过证据上限）。关闭则仅保留词法排序。"
        },
        "codeChasing.maxExplorationRounds": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "回答前模型自主检索/阅读的最大轮数。超大仓库或跨模块研究问题可调高。"
        },
        "codeChasing.maxVisualPages": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "description": "一次视觉论文提问或贯穿讲解最多发送的 PDF 页图数。"
        },
        "codeChasing.sendCodeByDefault": {
          "type": "boolean",
          "default": false,
          "description": "普通聊天也检索相关仓库代码。关闭时，明确的代码问题与编辑器选中代码仍可能检索相关代码。"
        },
        "codeChasing.confirmContextBeforeSend": {
          "type": "boolean",
          "default": false,
          "description": "每次带上下文的请求前先确认论文/代码上下文。默认关闭以保持聊天连贯。"
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs && node scripts/test-stability.mjs",
    "check:webviews": "node --check media/assistant.js && node --check media/pdfViewer.js",
    "check": "npm run typecheck && npm run check:webviews && npm run test && npm run compile",
    "vscode:prepublish": "npm run check"
  },
  "dependencies": {
    "katex": "0.16.22",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
